# Root .gitignore for monorepo RRHH
# OS
.DS_Store
Thumbs.db
nul

# Environment
.env
.env.*
!.env.example
!.env.*.example

# Node
**/node_modules/
**/dist/
**/.output/
**/.nuxt/
/package-lock.json
/yarn.lock

# PHP / Laravel
**/vendor/
**/vendor_tmp/
**/.phpunit.result.cache
**/.phpactor
**/storage/*.key
/back_vendor

# Local scratch scripts (create users/tokens, broadcast tests) must never
# end up in the repository or in CI artifacts.
BACK/_scripts/

# IDEs / editors
/.idea
/.vscode
/.phpstorm.meta.php

# Docker
**/.docker
**/docker-compose.override.yml

# Build / runtime
/public/build
/public/hot
/storage/framework/cache/data

# OneDrive
~lock*
