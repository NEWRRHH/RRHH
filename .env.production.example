# =============================================================================
# RRHH - production environment (server PC)
#
# This is the ONLY env file the server needs: BACK/.env and FRONT/.env are
# not required. Setup:
#   1. cp .env.production.example .env
#   2. docker compose up -d --build
#      -> the "env-check" service stops the start-up and prints every missing
#         credential (secrets already generated). If you used -d, see them with:
#         docker compose logs env-check
#   3. Paste them into .env and run step 2 again
#   Migrations run by themselves on every start (service "migrate").
#   Full guide: DEPLOY.md
# =============================================================================

# --- Docker compose -----------------------------------------------------------
# Production overrides: compiled Nuxt + env-check. The separator is fixed to
# ":" so the same line works on Windows and Linux.
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
COMPOSE_PATH_SEPARATOR=:

# tunnel-domain -> named Cloudflare tunnel on your own domain (fixed URL)
# tunnel        -> quick tunnel, random *.trycloudflare.com URL (no domain yet)
COMPOSE_PROFILES=tunnel-domain

# Cloudflare Zero Trust > Networks > Tunnels > (your tunnel) > token.
# Public hostname of the tunnel: rrhh.nanodev.com -> http://gateway:80
CLOUDFLARE_TUNNEL_TOKEN=

# Public hostname(s) accepted by the front (comma separated).
PUBLIC_HOSTS=rrhh.nanodev.com

# --- Laravel ------------------------------------------------------------------
APP_NAME=RRHH
APP_ENV=production
APP_DEBUG=false
APP_URL=https://rrhh.nanodev.com
# Generate with: docker compose run --rm app php artisan key:generate --show
APP_KEY=
APP_TIMEZONE=Europe/Madrid
APP_LOCALE=es
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# --- First super admin (created only on the very first start) -----------------
# Change the password from the app afterwards; it is never overwritten.
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=

# --- Database (MySQL container) -----------------------------------------------
# Use long random passwords, e.g.: openssl rand -hex 24
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

# Browser talks to Nuxt on the same origin; only needed if something calls
# the API directly from another origin.
CORS_ALLOWED_ORIGINS=https://rrhh.nanodev.com
SANCTUM_EXPIRATION=10080

# --- Mail ---------------------------------------------------------------------
# "log" writes mails to storage/logs. Switch to smtp when you have a provider.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@nanodev.com
MAIL_FROM_NAME="${APP_NAME}"

# --- Reverb (WebSockets) ------------------------------------------------------
# Generate key/secret with: openssl rand -hex 16
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=rrhh
REVERB_APP_KEY=
REVERB_APP_SECRET=

# --- Nuxt (front) -------------------------------------------------------------
# Served over HTTPS through the tunnel -> secure session cookie.
NUXT_COOKIE_SECURE=true
NUXT_PUBLIC_REVERB_APP_ID=${REVERB_APP_ID}
NUXT_PUBLIC_REVERB_APP_KEY=${REVERB_APP_KEY}
